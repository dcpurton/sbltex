      { \normalfont \normalsize \scshape \filright }
      { \thesubsection }
      { .5em }
      { }
    \titleformat
      { \subsubsection }
      [ runin ]
      { \normalfont \normalsize \scshape }
      { \thesubsubsection }
      { .5em }
      { }
    \titleformat
      { \paragraph }
      [ runin ]
      { \normalfont \normalsize \itshape }
      { \theparagraph }
      { .5em }
      { }
    \titleformat
      { \subparagraph }
      [ runin ]
      { \normalfont \normalsize \scshape }
      { \thesubparagraph }
      { .5em }
      { }
  }
