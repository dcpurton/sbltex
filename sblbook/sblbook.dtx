                \appendixname
                \ifnum \c@sblbook@appendix@count > 1
                  \strut \space \thecontentslabel
                \fi
                : \enspace
              }
          }
          { }
          { \hspace { 0.5em } \titlerule* [ 0.5pc ] { . } \contentspage }
      }
  }
%    \end{macrocode}
